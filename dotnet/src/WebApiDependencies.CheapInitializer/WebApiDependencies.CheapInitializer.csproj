<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SmartStandards.WebApiDependencies.CheapInitializer</AssemblyName>
    <RootNamespace>Microsoft.AspNetCore</RootNamespace>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  
  <PropertyGroup>
    <PackageId>SmartStandards.WebApiDependencies</PackageId>
    <Description>SmartStandards.WebApiDependencies</Description>
    <Product>SmartStandards.WebApiDependencies</Product>
    <Company>(public domain)</Company>
    <Copyright>SmartStandards</Copyright>
    <Version>10.0.0</Version>
    <AssemblyVersion>10.0.0</AssemblyVersion>
    <Authors>SmartStandards</Authors>
    <FileVersion>10.0.0</FileVersion>
    <PackageTags>AspNetCore Dependencies CheapInitializer</PackageTags>
    <PackageProjectUrl>https://github.com/SmartStandards/AspNetCoreTemplate</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SmartStandards/AspNetCoreTemplate</RepositoryUrl>
  </PropertyGroup>
  
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DocumentationFile>..\..\dist\bin-net10.0\SmartStandards.WebApiDependencies.CheapInitializer.xml</DocumentationFile>
    <OutputPath>..\..\dist\bin-net10.0\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>1701;1702;1591</NoWarn>
    <DefineConstants>TRACE;DEBUG;NET8</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <OutputPath>..\..\dist\bin-net10.0\</OutputPath>
    <DocumentationFile>..\..\dist\bin-net10.0\SmartStandards.WebApiDependencies.CheapInitializer.xml</DocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>1701;1702;1591</NoWarn>
    <DefineConstants>TRACE;NET8</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="jose-jwt" Version="4.1.0" />
    <PackageReference Include="Microsoft.AspNetCore" Version="2.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="5.0.17" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="5.0.0" NoWarn="NU1605" />
    <PackageReference Include="Microsoft.AspNetCore.Cors" Version="2.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Http" Version="2.2.2" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc" Version="2.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Core" Version="2.2.5" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Cors" Version="2.2.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="SmartAmbience" Version="2.4.8" />
    <PackageReference Include="SmartAmbience.MvcSupport" Version="2.4.8" />
    <PackageReference Include="SmartStandards.AuthTokenHandling" Version="5.0.10" />
    <PackageReference Include="SmartStandards.AuthTokenHandling.MvcSupport" Version="5.0.10" />
    <PackageReference Include="SmartStandards.Essentials" Version="0.8.0" />
    <PackageReference Include="SmartStandards.Logging" Version="3.3.1" />
    <PackageReference Include="SmartStandards.Logging.AspSupport" Version="3.3.1" />
    <PackageReference Include="SmartStandards.Logging.Centralized" Version="3.3.1" />
    <PackageReference Include="Snowflake44" Version="3.7.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="6.5.0" />
    <PackageReference Include="System.Runtime" Version="4.3.1" />
    <PackageReference Include="System.ServiceModel.Primitives" Version="4.6.0" />
    <PackageReference Include="System.Text.Encodings.Web" Version="6.0.0" />
    <PackageReference Include="UJMW.DynamicClient" Version="5.4.0" />
    <PackageReference Include="UJMW.DynamicController" Version="5.4.0" />
  </ItemGroup>

</Project>
