<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>SmartStandards.WebApiDependencies.net10.0</id>
    <version>10.0.0</version>
    <title>SmartStandards WebApiDependencies (ASP.NET Core + common SmartStandards packages)</title>
    <authors>SmartStandards</authors>
    <owners>(public domain)</owners>
    <copyright>SmartStandards</copyright>
    <description>
      A reference package, which is intended to ensure that a set of well-defined versions of Microsoft base packages
      from the ASP environment are used. This should ensure that update blockades do not arise again and again due to
      minimal mismatches in the version constraints when multiple libs (from multiple repos) are aggregatged together.
    </description>
    <tags> ASP.NET Core Reference Package </tags>
    <!-- https://spdx.org/licenses/ -->
    <license type="expression">GPL-3.0-only</license>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <icon>PackageIcon.png</icon>
    <projectUrl>https://github.com/SmartStandards/AspNetCoreTemplate</projectUrl>
    <dependencies>
      <group targetFramework="net10.0">

        <!-- regarding any Microsoft packages, we rely on the base reference package... -->
        
        <dependency id="SmartStandards.WebApiDependencies.AspNetCore.net8.0" version="[8.0.3]" />
      
        <!-- ...and extend these here with the state-of-the-art packages from the 'SmartStandards' ecosystem -->

        <dependency id="Newtonsoft.Json" version="13.0.4" />
        
        <dependency id="Snowflake44" version="3.7.0" />
        <dependency id="SmartStandards.Essentials" version="0.8.0" />
        
        <dependency id="SmartStandards.Logging" version="3.3.1" />
        <dependency id="SmartStandards.Logging.AspSupport" version="3.3.1" />
        <dependency id="SmartStandards.Logging.Centralized" version="3.3.1" />
        
        <dependency id="UJMW.DynamicController" version="5.4.0" />
        <dependency id="UJMW.DynamicClient" version="5.4.0" />
        
        <dependency id="SmartStandards.AuthTokenHandling" version="5.0.10" />
        <dependency id="SmartStandards.AuthTokenHandling.MvcSupport" version="5.0.10" />
        
        <dependency id="SmartAmbience" version="2.4.8" />
        <dependency id="SmartAmbience.MvcSupport" version="2.4.8" />

      </group>
    </dependencies>
  </metadata>
  <files>
    <!-- https://docs.microsoft.com/en-us/nuget/create-packages/creating-a-package#from-a-convention-based-working-directory -->
    <file src="PackageIcon.png" target="" />
    <!-- .NET 10.0 -->
    <file src="dist\bin-net10.0\SmartStandards.WebApiDependencies.CheapInitializer.dll" target="lib/net10.0" />
    <file src="dist\bin-net10.0\SmartStandards.WebApiDependencies.CheapInitializer.xml" target="lib/net10.0" />
    <file src="dist\bin-net10.0\SmartStandards.WebApiDependencies.CheapInitializer.pdb" target="lib/net10.0" />
  </files>
</package>